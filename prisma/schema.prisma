model ActivityLog {
  id String @id @default(cuid())

  action ActivityAction

  userId       String
  targetUserId String?

  taskId     String?
  rewardId   String?
  chatRoomId String?

  createdAt DateTime @default(now())

  metadata Json?

  user       User  @relation("ActivityActor", fields: [userId], references: [id])
  targetUser User? @relation("ActivityTarget", fields: [targetUserId], references: [id])

  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reward   Reward?   @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  chatRoom ChatRoom? @relation(fields: [chatRoomId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([chatRoomId, createdAt])
  @@index([createdAt])
}

